# Frontend Evidia — copie para .env (ignorado pelo Git). Sem valores secretos aqui.
# URL da API operacional. Use o MESMO host do frontend (localhost) para que o cookie
# de sessao SameSite=Strict seja enviado. Sem esta variavel, as telas operacionais
# mostram erro de configuracao; elas nunca usam dados da demonstracao.
VITE_EVIDIA_API_URL=http://localhost:8007
