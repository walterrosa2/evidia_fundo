# Evidia API operacional — copie para backend/.env (ignorado pelo Git).
# Este arquivo contem apenas nomes e valores NAO secretos.

EVIDIA_ENV=development
EVIDIA_API_HOST=127.0.0.1
# Porta alocada pelo Painel de Solucoes (painel-solucoes-manager).
EVIDIA_API_PORT=8007

# Padrao: SQLite em backend/data/evidia.db e arquivos em backend/data/storage.
# EVIDIA_DATABASE_URL=sqlite:///C:/caminho/para/evidia.db
# EVIDIA_STORAGE_DIR=C:/caminho/para/storage
# EVIDIA_LOG_DIR=C:/caminho/para/logs

# Origens do navegador autorizadas (separadas por virgula). Nunca "*".
EVIDIA_CORS_ORIGINS=http://localhost:5180

# Administrador inicial. Sem senha, nenhum usuario e criado na inicializacao.
# Defina a senha real somente no .env e registre-a no Painel de Solucoes.
EVIDIA_ADMIN_USERNAME=admin
EVIDIA_ADMIN_PASSWORD=
EVIDIA_ADMIN_ORG_NAME=Organizacao local

EVIDIA_SESSION_TTL_HOURS=12
EVIDIA_MAX_UPLOAD_MB=200

# Originacao: disabled | fixture | http
#   disabled -> a entrada pela originacao responde erro de configuracao (sem dados demo)
#   fixture  -> dados SINTETICOS rotulados, para exercitar a jornada sem o provedor
#   http     -> API real da originacao (somente leitura); homologacao pendente (D3)
#   fixture -> casos sinteticos (testes)
#   http    -> API da originacao (aplicacao no ar + credencial de servico)
#   sqlite  -> leitura direta e SOMENTE-LEITURA do banco da originacao (dados reais)
EVIDIA_ORIGINATION_MODE=fixture
# Usado no modo sqlite: caminho do banco do coletor da originacao.
# EVIDIA_ORIGINATION_DB_PATH=C:/caminho/para/originacao-pipeline/coletor/originacao.sqlite
EVIDIA_ORIGINATION_BASE_URL=http://127.0.0.1:8010
EVIDIA_ORIGINATION_EMAIL=
EVIDIA_ORIGINATION_PASSWORD=
EVIDIA_ORIGINATION_TIMEOUT_SECONDS=15
EVIDIA_ORIGINATION_MAX_RETRIES=2

# Nulidade360: disabled | mock
#   disabled -> iniciar execucao responde erro de configuracao
#   mock     -> servico do Nulidade360 rodando com MOCK_AI=true; so aceita .txt/.md (sem custo)
#   live     -> servico do Nulidade360 em modo real: CADA ANALISE CONSOME API PAGA; exige
#               autorizacao de custo (ver scripts/start_nulidade360_live.ps1)
# Execucao real (API paga) nao esta habilitada nesta versao.
EVIDIA_NULIDADE360_MODE=disabled
EVIDIA_NULIDADE360_BASE_URL=http://127.0.0.1:8530
EVIDIA_NULIDADE360_TIMEOUT_SECONDS=30
EVIDIA_NULIDADE360_DEADLINE_MINUTES=30

# Trabalhador em segundo plano (fila de OCR/texto e reconciliacao das execucoes de motor).
EVIDIA_WORKER_ENABLED=true
EVIDIA_WORKER_INTERVAL_SECONDS=5

# OCR local com Tesseract (sem custo, nada sai da maquina).
EVIDIA_TESSERACT_CMD=tesseract
EVIDIA_OCR_LANGUAGE=por
EVIDIA_OCR_MAX_PAGES=500

# Modelo de linguagem para sugestao de afirmacoes: disabled | mock | gemini
#   disabled -> so a extracao por regras locais fica disponivel
#   mock     -> resposta deterministica, sem rede e sem custo (para testes)
#   gemini   -> API PAGA; exige EVIDIA_LLM_API_KEY no .env e autorizacao de custo
EVIDIA_LLM_MODE=disabled
EVIDIA_LLM_API_KEY=
EVIDIA_LLM_MODEL=gemini-2.5-flash
EVIDIA_LLM_MAX_PAGES_PER_CALL=20

# Diligencia de vinculos: disabled | fixture
#   fixture -> fonte SINTETICA rotulada, para exercitar o fluxo. Fonte real depende de D3.
EVIDIA_DILIGENCE_MODE=fixture

# Politica de colunas por papel (D5). Vazio = padrao: o papel de leitura nao ve o identificador
# na origem nem hash e nome de arquivo dos documentos. Ajuste em JSON, ex.:
#   EVIDIA_COLUMN_POLICY={"claims.asserted_by": ["admin", "reviewer"], "documents.sha256": ["*"]}
# EVIDIA_COLUMN_POLICY=
# Exige que o memorando seja aprovado por pessoa diferente de quem o emitiu.
EVIDIA_MEMO_DISTINCT_APPROVER=false
