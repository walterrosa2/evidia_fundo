{
  "$defs": {
    "EngineBlock": {
      "additionalProperties": false,
      "description": "Bloco ou pilar da auditoria, com o estado que o motor devolveu.",
      "properties": {
        "key": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "label": {
          "default": "",
          "maxLength": 200,
          "title": "Label",
          "type": "string"
        },
        "message": {
          "default": "",
          "maxLength": 1000,
          "title": "Message",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "key",
        "status"
      ],
      "title": "EngineBlock",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Envelope minimo de uma execucao de motor.",
  "properties": {
    "attempts": {
      "minimum": 1,
      "title": "Attempts",
      "type": "integer"
    },
    "blocks": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EngineBlock"
      },
      "title": "Blocks",
      "type": "array"
    },
    "checklist_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checklist Version"
    },
    "cost_amount": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Amount"
    },
    "cost_currency": {
      "anyOf": [
        {
          "maxLength": 3,
          "minLength": 3,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost Currency"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "document_version_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Document Version Ids",
      "type": "array"
    },
    "dossier_version": {
      "minimum": 0,
      "title": "Dossier Version",
      "type": "integer"
    },
    "engine": {
      "enum": [
        "nulidade360",
        "p4"
      ],
      "title": "Engine",
      "type": "string"
    },
    "engine_status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Engine Status"
    },
    "engine_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Engine Version"
    },
    "evidence_map": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Map"
    },
    "external_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Ref"
    },
    "findings_count": {
      "default": 0,
      "minimum": 0,
      "title": "Findings Count",
      "type": "integer"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "input_hash": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Input Hash",
      "type": "string"
    },
    "is_mock": {
      "title": "Is Mock",
      "type": "boolean"
    },
    "is_synthetic": {
      "default": false,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "items_count": {
      "default": 0,
      "minimum": 0,
      "title": "Items Count",
      "type": "integer"
    },
    "limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "opportunity_id": {
      "title": "Opportunity Id",
      "type": "string"
    },
    "overall_risk_index": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "ge": 0,
          "le": 100
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Overall Risk Index"
    },
    "prompt_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prompt Version"
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "side_confirmed_by": {
      "maxLength": 36,
      "minLength": 1,
      "title": "Side Confirmed By",
      "type": "string"
    },
    "simulated_side": {
      "enum": [
        "claimant",
        "defendant"
      ],
      "title": "Simulated Side",
      "type": "string"
    },
    "stale": {
      "default": false,
      "title": "Stale",
      "type": "boolean"
    },
    "stale_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stale Reason"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "partial",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "usage": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "integer"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Usage"
    }
  },
  "required": [
    "id",
    "opportunity_id",
    "dossier_version",
    "engine",
    "input_hash",
    "document_version_ids",
    "simulated_side",
    "side_confirmed_by",
    "status",
    "attempts",
    "is_mock",
    "created_at"
  ],
  "title": "EngineRunOut",
  "type": "object"
}
